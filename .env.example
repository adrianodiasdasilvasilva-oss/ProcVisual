# GEMINI_API_KEY_: Required for Gemini AI API calls (Server-side only).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY_="SUA_NOVA_CHAVE_AQUI"

# WHAPI_TOKEN: Token for Whapi Cloud API (WhatsApp notifications).
WHAPI_TOKEN="SUA_CHAVE_WHAPI_AQUI"
