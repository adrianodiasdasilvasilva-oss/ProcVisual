rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.uid == "24cC8kguY3X3IwSwfh6tTAKmJOK2" ||
         request.auth.uid == "o60eUYDOD6WD4o1j8YBZoOXqfiR2" ||
         request.auth.uid == "uCpsT3N8pAWWzAsP74qKqPTeYAt2" ||
         (request.auth.token.email != null && 
          (request.auth.token.email == "adrianodiasdasilva@yahoo.com.br" || 
           request.auth.token.email == "adrianodiasdasilva.silva@gmail.com")));
    }

    function isValidUser(data) {
      return (!('nome' in data) || data.nome is string) &&
             (!('email' in data) || data.email is string) &&
             (!('telefone' in data) || data.telefone is string);
    }

    function isValidLancamento(data) {
      // Must be authenticated OR come from WhatsApp (which we check via origem field)
      return (isAuthenticated() || (data.origem != null && data.origem.matches("whatsapp.*"))) &&
             data.tipo in ['income', 'expense', 'birthday', 'despesa'] &&
             data.valor is number &&
             data.categoria is string &&
             data.data is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Users Collection
    match /usuarios/{userId} {
      // ONLY owner or admin can see profile data
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      // Allow owner or admin to update
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Lancamentos Collection
    match /lancamentos/{lancamentoId} {
      // ONLY owner or admin can see financial logs
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Client can only create for themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidLancamento(request.resource.data);
      
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Categorias Collection
    match /categorias/{categoriaId} {
      // ONLY owner can read/write their own categories
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Config Collection (Last Cron Run monitoring)
    match /config/{configId} {
      allow read: if isAdmin();
      allow write: if false; // Only backend (admin SDK) can write
    }
  }
}
