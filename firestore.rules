rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email.lower() == "adrianodiasilva@yahoo.com.br" || 
         request.auth.token.email.lower() == "adrianodiasdasilva.silva@gmail.com");
    }

    function isValidUser(data) {
      return (!('nome' in data) || data.nome is string) &&
             (!('email' in data) || data.email is string) &&
             (!('telefone' in data) || data.telefone is string);
    }

    function isValidLancamento(data) {
      // Must be authenticated OR come from WhatsApp (which we check via origem field)
      return (isAuthenticated() || (data.origem != null && data.origem.matches("whatsapp.*"))) &&
             data.tipo in ['income', 'expense', 'birthday', 'despesa'] &&
             data.valor is number &&
             data.categoria is string &&
             data.data is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Users Collection
    match /usuarios/{userId} {
      // Allow read for bot and owner/admin
      allow get: if true; 
      allow list: if true;
      
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      // Allow bot to save pending expenses
      allow update: if (isOwner(userId) || isAdmin()) || (request.auth == null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingWhatsAppExpense']));
      allow delete: if isAdmin();
    }

    // Lancamentos Collection
    match /lancamentos/{lancamentoId} {
      // Allow read for users, admins and bot (limited to 500)
      allow read: if (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin())) || 
                    request.query.limit <= 500 || 
                    (resource != null && resource.data.origem.matches("whatsapp.*"));
      
      allow create: if (isAuthenticated() && isValidLancamento(request.resource.data)) ||
                    (request.auth == null && request.resource.data.origem.matches("whatsapp.*") && isValidLancamento(request.resource.data));
      
      allow update: if (isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin())) ||
                    (resource.data.userId == "whatsapp_pending" && request.resource.data.userId == request.auth.uid) ||
                    // Allow server background job to update notification flags
                    (request.auth == null && (request.resource.data.diff(resource.data).affectedKeys().hasAny(['notificadoAmanha', 'notificadoNoDia', 'notificado5dias'])));
      
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Categorias Collection
    match /categorias/{categoriaId} {
      allow read: if true;
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) ||
                    (request.auth == null && request.resource.data.origem != null && request.resource.data.origem.matches("whatsapp.*"));
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
