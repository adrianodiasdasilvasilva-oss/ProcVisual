{
  "entities": {
    "usuario": {
      "title": "Usuário",
      "description": "Perfil do usuário da ProcVisual",
      "type": "object",
      "properties": {
        "nome": {
          "type": "string",
          "description": "Nome completo do usuário"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email de contato"
        },
        "telefone": {
          "type": "string",
          "description": "Telefone de contato"
        },
        "dataCriacao": {
          "type": "string",
          "format": "date-time",
          "description": "Data em que o perfil foi criado"
        },
        "fotoURL": {
          "type": "string",
          "description": "URL ou base64 da foto de perfil"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização do perfil"
        }
      },
      "required": ["nome", "email", "dataCriacao"]
    },
    "lancamento": {
      "title": "Lançamento",
      "description": "Registro financeiro de receita ou despesa",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID do usuário proprietário do lançamento"
        },
        "tipo": {
          "type": "string",
          "enum": ["income", "expense", "birthday"],
          "description": "Tipo do lançamento (Receita, Despesa ou Aniversário)"
        },
        "valor": {
          "type": "number",
          "description": "Valor monetário do lançamento"
        },
        "categoria": {
          "type": "string",
          "description": "Categoria do lançamento"
        },
        "data": {
          "type": "string",
          "format": "date",
          "description": "Data da transação ou aniversário"
        },
        "descricao": {
          "type": "string",
          "description": "Descrição detalhada ou nome do aniversariante"
        },
        "estabelecimento": {
          "type": "string",
          "description": "Nome do estabelecimento ou aniversariante"
        },
        "telefone": {
          "type": "string",
          "description": "Telefone para notificações"
        },
        "pago": {
          "type": "boolean",
          "description": "Status de pagamento (apenas para despesas)"
        },
        "notificado5dias": {
          "type": "boolean",
          "description": "Se já foi notificado 5 dias antes"
        },
        "notificadoNoDia": {
          "type": "boolean",
          "description": "Se já foi notificado no dia"
        },
        "notificadoAmanha": {
          "type": "boolean",
          "description": "Se já foi notificado 1 dia antes (aniversários)"
        },
        "parcela": {
          "type": "integer",
          "description": "Número da parcela atual"
        },
        "totalParcelas": {
          "type": "integer",
          "description": "Total de parcelas ou anos de repetição"
        },
        "groupId": {
          "type": "string",
          "description": "ID do grupo para lançamentos parcelados ou repetidos"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação do registro"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização"
        }
      },
      "required": ["userId", "tipo", "valor", "categoria", "data"]
    }
  },
  "firestore": {
    "/usuarios/{userId}": {
      "schema": "usuario",
      "description": "Coleção de perfis de usuários"
    },
    "/lancamentos/{lancamentoId}": {
      "schema": "lancamento",
      "description": "Coleção de todos os lançamentos financeiros"
    }
  }
}
